# Python environment and generated bytecode
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest*/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local test, certification, and scratch outputs
.r3*/
.test-tmp/
.tmp_pytest*/
/_test_tmp/
/runs_test_tmp/
/tmp/
/b030cert/
/certl1/
/certl2/
/c1/
/c2/
/c3/
/t/
/u/
/v/
/w/
/x/
/y/
/z/

# Production artifacts and local state
/runs/
/data/
/output/
/.b029-*-repro-*/
/src/booktrans.egg-info/
*.db
*.sqlite
*.sqlite3
*.log
*.log.*
*.err
/.release-*
/.supervisor-*

# Immutable, copyrighted source material kept only locally. Root-only rules
# preserve approved synthetic fixtures such as tests/fixtures/*.docx.
/*.docx
/*.pdf

# Downloaded local renderer/toolchain
/tools/libreoffice/
/tools/*.msi

# Credentials and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.kdbx
